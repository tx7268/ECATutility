       <item row="1" column="1">
        <widget class="QPushButton" name="btn_do1_1">
         <property name="styleSheet">
          <string notr="true">QPushButton {
    /* 基础样式：浅灰圆形 */
    background-color: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 25px;       /* 圆形关键：宽高相等时，半径设为一半 */
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
    font-size: 12px;
    color: #333333;            /* 文字颜色 */
}

/* 悬停状态：鼠标放上去时轻微变灰 */
QPushButton:hover {
    background-color: #e8e8e8;
    border: 1px solid #bdbdbd;
}


QPushButton:checked {
    background-color: #4caf50; /* 主绿色 */
    border: 1px solid #388e3c; /* 深绿色边框 */
    color: #ffffff;            /* 文字变白，更醒目 */
}

QPushButton:checked:hover {
    background-color: #388e3c;
}</string>
         </property>
         <property name="text">
          <string/>
         </property>
